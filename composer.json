{
    "name": "netauratech/core-cms",
    "description": "Le cœur du CMS, fournissant la structure de base, les services et l'interface d'administration.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "cms",
        "core"
    ],
    "autoload": {
        "psr-4": {
            "Netauratech\\CoreCms\\": "src/",
            "Database\\Factories\\": "src/database/factories/",
            "Database\\Seeders\\": "src/database/seeders/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "NetAuraTech",
            "email": "contact@netauratech.fr"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Netauratech\\CoreCms\\Tests\\": "tests/",
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/",
            "Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "require": {
        "php": "^8.1",
        "intervention/image": "^2.7.2",
        "laravel/breeze": "^2.3",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.2",
        "laravel/socialite": "^5.18",
        "litespeed/lscache-laravel": "^1.3",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-permission": "^6.21"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Netauratech\\CoreCms\\CoreCmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit"
        ],
        "test-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit --coverage-html coverage"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.5",
        "phpunit/phpunit": "^12.3"
    }
}