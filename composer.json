{
    "name": "netauratech/core-cms",
    "description": "Le cœur du CMS, fournissant la structure de base, les services et l'interface d'administration.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "cms",
        "core"
    ],
    "autoload": {
        "psr-4": {
            "Netauratech\\CoreCms\\": "src/",
            "Database\\Factories\\": "src/database/factories/",
            "Database\\Seeders\\": "src/database/seeders/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "NetAuraTech",
            "email": "contact@netauratech.fr"
        }
    ],
    "require": {
        "php": "^8.1",
        "intervention/image": "^2.7.2",
        "laravel/breeze": "^2.3",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.2",
        "laravel/socialite": "^5.18",
        "litespeed/lscache-laravel": "^1.3",
        "spatie/laravel-permission": "^6.21"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Netauratech\\CoreCms\\CoreCmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
